# Matplotlib style for every figure of the Python edition.
# Loaded through creators/python/bookfig.py; one source of truth for the
# book's look.
#
# Figures are saved at their printed size (see bookfig.py) and shown without
# any scaling, so these point sizes are the sizes on the page: next to the
# 11 pt body text, labels are 10 pt and tick labels 9 pt. The web pages show
# each image at the same physical size (shared/_ext/natural_size.py).

font.family: serif
font.serif: cmr10, Computer Modern Roman, DejaVu Serif
font.size: 10
axes.labelsize: 10
axes.titlesize: 10
xtick.labelsize: 9
ytick.labelsize: 9
legend.fontsize: 9
legend.frameon: False
mathtext.fontset: cm
axes.formatter.use_mathtext: True
axes.unicode_minus: True

axes.linewidth: 0.6
xtick.major.width: 0.6
ytick.major.width: 0.6
xtick.major.size: 3
ytick.major.size: 3
lines.linewidth: 1.0
lines.markersize: 3

figure.constrained_layout.use: True
figure.dpi: 100
savefig.dpi: 300
savefig.bbox: standard
